# =========================================================================
# CONFIGURACIÓN DEL SERVIDOR MCP
# Copia este archivo a .env y ajusta los valores.
# En Azure, configura estas variables en Application Settings (no uses .env).
# =========================================================================

# --- MODO MULTI-USUARIO (recomendado) ---
# Cada usuario tiene su propia API key que el servidor mapea a su user_id.
# La misma API key va en: este archivo, el config.json del plugin, y Copilot Studio.
# Formato JSON: {"api_key_usuario": "user_id_del_usuario"}
USERS_CONFIG={"clave_usuario_a": "usuario_a", "clave_usuario_b": "usuario_b"}

# --- MODO UN SOLO USUARIO (retrocompatibilidad) ---
# Usa esto si solo necesitas un usuario. No necesitas USERS_CONFIG.
# API_KEY=tu_clave_secreta
# USER_ID=mi_usuario

# Puerto local para desarrollo (Azure lo sobreescribe automáticamente)
PORT=8000
