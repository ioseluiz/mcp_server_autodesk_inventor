<?xml version="1.0" encoding="utf-8"?>
<Addin Type="Standard">
  <ClassId>{E1A5A5A5-A5A5-A5A5-A5A5-A5A5A5A5A5A5}</ClassId>
  <ClientId>{E1A5A5A5-A5A5-A5A5-A5A5-A5A5A5A5A5A5}</ClientId>
  <DisplayName>Inventor MCP Bridge</DisplayName>
  <Description>Bridge between MCP Server and Autodesk Inventor</Description>
  <Assembly>InventorMCPBridge.dll</Assembly>
  <LoadOnStartUp>1</LoadOnStartUp>
  <UserUnloadable>1</UserUnloadable>
  <Hidden>0</Hidden>
  <OSType>Win64</OSType>
  <!-- 29.. = Inventor 2026 y superior. El add-in es .NET 8, por lo que no puede cargarse
       en Inventor 2024 o anterior (host con CLR .NET Framework 4.8). -->
  <SupportedSoftwareVersionGreaterThan>29..</SupportedSoftwareVersionGreaterThan>
  <!-- Al pasar a Inventor 2027, descomentar para usar su aislamiento de ensamblados nativo:
  <UseInventorAssemblyContext>0</UseInventorAssemblyContext>
  -->
  <DataVersion>1</DataVersion>
</Addin>
