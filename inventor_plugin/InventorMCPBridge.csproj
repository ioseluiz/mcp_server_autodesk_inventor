<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Inventor 2025+ hosts .NET 8; a net48 assembly no longer loads. Requires Inventor 2026. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>InventorMCPBridge</AssemblyName>
    <RootNamespace>InventorMCPBridge</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Keep the output in bin\x64\<Config>\ instead of the net8.0-windows subfolder,
         which is where Inventor and the installer expect the add-in files. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- No NuGet dependencies on purpose: Inventor 2025/2026 loads add-ins into the default
       AssemblyLoadContext, so any package we ship can clash with Inventor's own copy.
       JSON is handled by System.Text.Json (see Services/JsonPayload.cs). -->

  <!-- Resolve Inventor Interop: use local installation if present, else fall back to lib/ (for CI) -->
  <PropertyGroup>
    <_InventorInteropSystem>C:\Program Files\Autodesk\Inventor 2026\Bin\Public Assemblies\Autodesk.Inventor.Interop.dll</_InventorInteropSystem>
    <InventorInteropPath Condition="Exists('$(_InventorInteropSystem)')">$(_InventorInteropSystem)</InventorInteropPath>
    <InventorInteropPath Condition="'$(InventorInteropPath)' == ''">$(MSBuildProjectDirectory)\..\lib\Autodesk.Inventor.Interop.dll</InventorInteropPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropPath)</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="InventorMCPBridge.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
